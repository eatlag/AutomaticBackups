<Window x:Class="AutomaticBackups.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Automatic Backups" Height="820" Width="1260" MinHeight="700" MinWidth="1040"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowSurface}" FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}">
    <Window.Icon><BitmapImage UriSource="pack://application:,,,/Assets/AutomaticBackups.ico"/></Window.Icon>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource SidebarGradient}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Bottom" Margin="21,0,0,18">
                    <TextBlock Text="Private by design" Foreground="#D2E4F2" FontSize="10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Made by EatLag" Foreground="#63D9F1" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="Website ↗" Click="Website_Click" Padding="8,4" FontSize="10" Margin="9,0,0,0"
                                Foreground="#77E6F3" Background="#302653" BorderBrush="#6551A8" BorderThickness="1"
                                ToolTip="Open eatlag.net"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="23,25,18,31">
                        <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentGradient}"><TextBlock Text="AB" Foreground="#27D9F3" FontSize="15" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="Automatic Backups" Foreground="White" FontSize="16" FontWeight="Bold"/><TextBlock Text="YOUR FILES, SAFELY STORED" Foreground="#B3C9E0" FontSize="9" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel>
                    </StackPanel>
                    <TextBlock Text="WORKSPACE" Foreground="#7E8BA2" FontSize="10" FontWeight="Bold" Margin="23,0,0,10"/>
                    <Button x:Name="ProfilesNavButton" Content="▣   Backups" HorizontalContentAlignment="Left" Background="#35436D" Foreground="White" BorderBrush="Transparent" Margin="12,0,12,5" Padding="12,10" Click="ProfilesNav_Click"/>
                    <Button x:Name="SettingsNavButton" Content="⚙   Settings" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#D2E4F2" BorderBrush="Transparent" Margin="12,0,12,5" Padding="12,10" Click="SettingsNav_Click"/>
                    <TextBlock Text="BACKUP HEALTH" Foreground="#7E8BA2" FontSize="10" FontWeight="Bold" Margin="23,24,0,10"/>
                    <Border Background="#28345E" CornerRadius="11" Margin="14,0,14,0" Padding="14">
                        <StackPanel><TextBlock Text="PROFILES" Foreground="#97A4BC" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="StatProfiles" Text="0" Foreground="White" FontSize="27" FontWeight="Bold" Margin="0,2,0,13"/><TextBlock Text="NEXT SCHEDULED" Foreground="#97A4BC" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="StatNext" Text="Not scheduled" Foreground="White" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
                    </Border>
                    <Border Background="#28345E" CornerRadius="11" Margin="14,12,14,0" Padding="14"><StackPanel><TextBlock Text="A QUICK NOTE" Foreground="#A9C7DB" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="Keep Automatic Backups open to let your schedules run." Foreground="#E0F4FA" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,0"/></StackPanel></Border>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="30,23,30,23">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,21">
                <StackPanel><TextBlock Text="Backup profiles" FontSize="27" FontWeight="Bold"/><TextBlock Text="Create ZIP backups on a schedule, with settings tailored to each source." Foreground="{DynamicResource TextMuted}" FontSize="13" Margin="0,5,0,0"/></StackPanel>
                <Button x:Name="AddProfileButton" Content="＋   New backup" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource AccentGradient}" Foreground="White" BorderBrush="Transparent" Padding="17,10" Click="AddProfile_Click"/>
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource CardSurface}" CornerRadius="12" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="16" Margin="0,0,0,15">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal"><Border Width="34" Height="34" CornerRadius="10" Background="#D9F8FC"><TextBlock Text="↻" Foreground="#178CA8" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="Automatic backups" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Schedules check in the background while Automatic Backups is open." Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></StackPanel>
                    <TextBlock x:Name="ScheduleStatus" Grid.Column="1" Text="●  READY" Foreground="#18845D" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource CardSurface}" CornerRadius="12" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Margin="0,0,14,0">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Padding="18,16" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="YOUR BACKUPS" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="ProfileCount" Text="0 profiles configured" FontSize="15" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border>
                        <Grid Grid.Row="1">
                            <ListBox x:Name="ProfileList" BorderThickness="0" Background="Transparent" Padding="9" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ProfileList_SelectionChanged">
                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" CornerRadius="10" Background="Transparent" Padding="0"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource SelectedSurface}"/><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource CardBorder}"/><Setter TargetName="Card" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource HoverSurface}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="9" Padding="13" Margin="2,3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Foreground="#4485E8" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/></StackPanel><TextBlock Text="{Binding Source}" Foreground="{DynamicResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="22,5,0,0"/><TextBlock Text="{Binding ScheduleLabel}" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="22,5,0,0"/><TextBlock Text="{Binding LastRunLabel}" Foreground="{DynamicResource TextFaint}" FontSize="10" Margin="22,5,0,0"/><TextBlock Text="{Binding NextBackupLabel}" Foreground="#38C7E0" FontSize="10" FontWeight="SemiBold" Margin="22,5,0,0"/></StackPanel><Border Grid.Column="1" Background="#E1FAF8" CornerRadius="10" Padding="8,4" VerticalAlignment="Top"><TextBlock Text="●  ACTIVE" Foreground="#168C91" FontSize="8" FontWeight="Bold"/></Border></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible"><Border Width="64" Height="64" CornerRadius="20" Background="#E6F5FF" HorizontalAlignment="Center"><TextBlock Text="▣" Foreground="#4D72E8" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Your backup list is ready" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" Margin="0,14,0,0"/><TextBlock Text="Add a folder or file to create your first scheduled backup." Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Width="240" Margin="0,6,0,0"/><Button Content="＋  Create your first backup" Margin="0,15,0,0" Background="{DynamicResource AccentGradient}" Foreground="White" BorderBrush="Transparent" Click="AddProfile_Click"/></StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="1.08*"/><RowDefinition Height="0.92*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource CardSurface}" CornerRadius="12" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="17" Margin="0,0,0,14">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid><StackPanel Orientation="Horizontal"><Border Width="34" Height="34" CornerRadius="10" Background="#E3F8FF"><TextBlock Text="▣" Foreground="#4381E9" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="SelectedName" Text="Select a backup" FontWeight="Bold" FontSize="14"/><TextBlock x:Name="SelectedSchedule" Text="Your backup details will appear here." Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,3,0,0"/></StackPanel></StackPanel></Grid>
                            <StackPanel Grid.Row="1" Margin="0,17,0,10"><TextBlock Text="SOURCE" Foreground="{DynamicResource TextMuted}" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="SelectedSource" Text="—" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,11"/><TextBlock Text="DESTINATION" Foreground="{DynamicResource TextMuted}" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="SelectedDestination" Text="—" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,11"/><TextBlock x:Name="SelectedOptions" Text="Choose a profile to view its ZIP and retention settings." Foreground="{DynamicResource TextMuted}" FontSize="10" TextWrapping="Wrap"/></StackPanel>
                            <WrapPanel Grid.Row="2"><Button x:Name="RunButton" Content="▶   Run now" Background="{DynamicResource AccentGradient}" Foreground="White" BorderBrush="Transparent" Click="RunSelected_Click" IsEnabled="False" Margin="0,0,7,0"/><Button x:Name="EditButton" Content="Edit" Click="EditSelected_Click" IsEnabled="False" Margin="0,0,7,0"/><Button x:Name="DeleteButton" Content="Delete" Click="DeleteSelected_Click" IsEnabled="False"/></WrapPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Background="{DynamicResource CardSurface}" CornerRadius="12" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Margin="0,0,0,14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="17,14,17,10"><StackPanel><TextBlock Text="RECENT ACTIVITY" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="ActivitySubtitle" Text="Backups and schedule events" Foreground="{DynamicResource TextFaint}" FontSize="10" Margin="0,3,0,0"/></StackPanel><Button x:Name="ClearLogButton" Content="Clear" HorizontalAlignment="Right" Padding="9,4" FontSize="10" Click="ClearLog_Click"/></Grid><TextBox x:Name="ActivityLog" Grid.Row="1" Margin="12,0,12,12" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="{DynamicResource InputSurface}" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource TextSecondary}"/></Grid></Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>

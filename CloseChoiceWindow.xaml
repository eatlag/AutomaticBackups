<Window x:Class="AutomaticBackups.CloseChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Close Automatic Backups?" Width="470" Height="350" MinWidth="470" MinHeight="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowSurface}" FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}">
    <Window.Icon><BitmapImage UriSource="pack://application:,,,/Assets/AutomaticBackups.ico"/></Window.Icon>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="What would you like to do?" FontSize="21" FontWeight="Bold"/>
            <TextBlock Text="Your scheduled backups keep running while the app is minimised to the tray." Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2">
            <Button Click="Minimize_Click" Background="{DynamicResource AccentGradient}" Foreground="White" BorderBrush="Transparent" Padding="14,11" HorizontalContentAlignment="Left" Margin="0,0,0,9">
                <StackPanel><TextBlock Text="Minimise to system tray" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Keep backups scheduled and hide the main window." Foreground="#EAFBFF" FontSize="10" Margin="0,3,0,0"/></StackPanel>
            </Button>
            <Button Click="Quit_Click" Padding="14,11" HorizontalContentAlignment="Left" Margin="0,0,0,9">
                <StackPanel><TextBlock Text="Quit completely" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Close the app and stop scheduled backups." Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,3,0,0"/></StackPanel>
            </Button>
            <Button Content="Keep app open" Click="KeepOpen_Click" HorizontalAlignment="Right" Padding="13,8" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>

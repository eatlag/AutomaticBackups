<Window x:Class="AutomaticBackups.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings · Automatic Backups" Height="660" Width="780" MinHeight="610" MinWidth="660"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" Background="{DynamicResource WindowSurface}" FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}">
    <Window.Icon><BitmapImage UriSource="pack://application:,,,/Assets/AutomaticBackups.ico"/></Window.Icon>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource SidebarGradient}">
            <StackPanel Margin="18,24">
                <StackPanel Orientation="Horizontal" Margin="4,0,0,28"><Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentGradient}"><TextBlock Text="AB" Foreground="#27D9F3" FontSize="14" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Preferences" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
                <Border Background="#35436D" CornerRadius="8" Padding="11,10"><TextBlock Text="⚙   General" Foreground="White" FontWeight="SemiBold" FontSize="12"/></Border>
                <TextBlock Text="Private by design" Foreground="#D2E4F2" FontSize="10" Margin="4,360,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="4,5,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Made by EatLag" Foreground="#63D9F1" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="Website ↗" Click="Website_Click" Padding="8,4" FontSize="10" Margin="9,0,0,0"
                            Foreground="#77E6F3" Background="#302653" BorderBrush="#6551A8" BorderThickness="1"
                            ToolTip="Open eatlag.net"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Grid Grid.Column="1" Margin="28,26,28,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,20"><TextBlock Text="Settings" FontSize="25" FontWeight="Bold"/><TextBlock Text="Choose how Automatic Backups behaves on this PC." Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
            <TextBlock Grid.Row="1" Text="GENERAL" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,9"/>
            <StackPanel Grid.Row="2">
                <Border Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="15">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Appearance" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Choose a light or dark look for every app window." Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap" MaxWidth="400" Margin="0,5,12,0"/></StackPanel><ComboBox x:Name="ThemeSelector" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="ThemeSelector_SelectionChanged"><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox></Grid>
                </Border>
                <Border Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,10,0,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Start with Windows" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Open Automatic Backups automatically when you sign in to this Windows account." Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap" MaxWidth="400" Margin="0,5,12,0"/></StackPanel><CheckBox x:Name="RunOnLogonCheckBox" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" Checked="RunOnLogon_Changed" Unchecked="RunOnLogon_Changed"/></Grid>
                </Border>
                <Border Background="{DynamicResource InfoSurface}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,10,0,0"><StackPanel><TextBlock Text="SCHEDULES" Foreground="#24A9C5" FontSize="10" FontWeight="Bold"/><TextBlock Text="Schedules run while the app is open. Turn on Windows sign-in startup to resume them automatically after you sign in." Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" LineHeight="18" Margin="0,5,0,0"/></StackPanel></Border>
                <Border Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,10,0,0"><StackPanel><TextBlock Text="ABOUT &amp; DATA" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold"/><TextBlock Text="Automatic Backups · Version 1.2 · Made by EatLag" FontWeight="SemiBold" FontSize="12" Margin="0,6,0,0"/><TextBlock Text="Profiles, logs, and preferences are saved here:" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,5,0,2"/><TextBlock x:Name="DataDirectoryText" Foreground="{DynamicResource TextSecondary}" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border>
            </StackPanel>
            <Button Grid.Row="3" Content="Done" HorizontalAlignment="Right" IsCancel="True" Padding="20,8" Margin="0,15,0,0"/>
        </Grid>
    </Grid>
</Window>

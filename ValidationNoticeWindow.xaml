<Window x:Class="AutomaticBackups.ValidationNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Check backup settings" Width="440" SizeToContent="Height" MinWidth="400" MaxWidth="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowSurface}" FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}">
    <Window.Icon><BitmapImage UriSource="pack://application:,,,/Assets/AutomaticBackups.ico"/></Window.Icon>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Border Width="40" Height="40" CornerRadius="13" Background="#2A3857" VerticalAlignment="Top">
                <TextBlock Text="i" Foreground="#58D8EE" FontSize="21" FontWeight="Bold" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="Heading" FontSize="17" FontWeight="Bold"/>
                <TextBlock Text="A quick check before saving" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,0,0,16">
            <TextBlock x:Name="Message" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" LineHeight="18"/>
        </Border>
        <Button Grid.Row="2" Content="Got it" IsDefault="True" IsCancel="True" HorizontalAlignment="Right" Background="{DynamicResource AccentGradient}" Foreground="White" BorderBrush="Transparent" Padding="20,9"/>
    </Grid>
</Window>

<Application x:Class="AutomaticBackups.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Accent" Color="#24CBEA"/>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#35D7EA" Offset="0"/><GradientStop Color="#6551E8" Offset="1"/></LinearGradientBrush>
        <LinearGradientBrush x:Key="WindowSurface" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F0FCFF" Offset="0"/><GradientStop Color="#F8F5FF" Offset="1"/></LinearGradientBrush>
        <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#201742" Offset="0"/><GradientStop Color="#174D68" Offset="1"/></LinearGradientBrush>
        <SolidColorBrush x:Key="CardSurface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InputSurface" Color="#FBFCFE"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#202B3C"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#566A86"/>
        <SolidColorBrush x:Key="TextMuted" Color="#78849A"/>
        <SolidColorBrush x:Key="TextFaint" Color="#9AA4B5"/>
        <SolidColorBrush x:Key="CardBorder" Color="#E5E9F1"/>
        <SolidColorBrush x:Key="Divider" Color="#EEF0F5"/>
        <SolidColorBrush x:Key="HoverSurface" Color="#F7F8FC"/>
        <SolidColorBrush x:Key="SelectedSurface" Color="#F2F1FF"/>
        <SolidColorBrush x:Key="InfoSurface" Color="#EAF7FF"/>
        <SolidColorBrush x:Key="InfoBorder" Color="#CDEBF6"/>
        <SolidColorBrush x:Key="Ink" Color="#202B3C"/>
        <SolidColorBrush x:Key="Muted" Color="#78849A"/>
        <SolidColorBrush x:Key="Line" Color="#E5E9F1"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="Background" Value="{DynamicResource CardSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/><Setter Property="Background" Value="{DynamicResource InputSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,7"/><Setter Property="Background" Value="{DynamicResource InputSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/><Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,5,12,5"/></Style>
    </Application.Resources>
</Application>

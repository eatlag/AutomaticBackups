<Window x:Class="AutomaticBackups.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Automatic Backups · Profile settings" Height="770" Width="670" MinHeight="700" MinWidth="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" Background="{DynamicResource WindowSurface}" FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}">
    <Window.Icon><BitmapImage UriSource="pack://application:,,,/Assets/AutomaticBackups.ico"/></Window.Icon>
    <Grid Margin="23">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16"><TextBlock x:Name="DialogTitle" Text="New backup profile" FontSize="22" FontWeight="Bold"/><TextBlock Text="Choose what to back up and how often." Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="PROFILE NAME" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/><TextBox x:Name="NameBox" Margin="0,0,0,12"/>
                <TextBlock Text="SOURCE FOLDER OR FILE (OPTIONAL WITH DATABASE BACKUP)" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SourceBox"/><Button x:Name="BrowseSourceButton" Grid.Column="1" Content="Browse folders" Margin="8,0,0,0" Padding="10,7" Click="BrowseSourceFolder_Click"/><Button Grid.Column="2" Content="Choose file" Margin="6,0,0,0" Padding="10,7" Click="BrowseSourceFile_Click"/></Grid>
                <TextBlock Text="DESTINATION FOLDER" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DestinationBox"/><Button Grid.Column="1" Content="Browse" Margin="8,0,0,0" Padding="12,7" Click="BrowseDestination_Click"/></Grid>
                <Border Background="{DynamicResource CardSurface}" CornerRadius="10" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="13" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="IncludeDatabaseBox" Content="Include an XAMPP database backup" Margin="0,0,0,2" Checked="IncludeDatabase_Changed" Unchecked="IncludeDatabase_Changed"/>
                        <TextBlock Text="Database backup currently supports XAMPP only." Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="28,0,0,8"/>
                        <StackPanel x:Name="DatabaseOptionsPanel" Visibility="Collapsed">
                            <TextBlock Text="XAMPP INSTALLATION FOLDER" Foreground="{DynamicResource TextMuted}" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="XamppFolderBox"/><Button Grid.Column="1" Content="Browse" Margin="7,0,0,0" Padding="11,7" Click="BrowseXamppFolder_Click"/></Grid>
                            <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Database username" FontSize="10" Margin="0,0,0,4"/><TextBox x:Name="DatabaseUsernameBox"/></StackPanel><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Port" FontSize="10" Margin="0,0,0,4"/><TextBox x:Name="DatabasePortBox" Text="3306"/></StackPanel></Grid>
                            <TextBlock Text="Database password (leave empty if none)" FontSize="10" Margin="0,0,0,4"/><PasswordBox x:Name="DatabasePasswordBox" Margin="0,0,0,9" Padding="10,8"/>
                            <TextBlock Text="Database to include" FontSize="10" Margin="0,0,0,4"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="DatabaseSelector"/><Button x:Name="RefreshDatabasesButton" Grid.Column="1" Content="↻  Refresh" Margin="7,0,0,0" Padding="12,7" Click="RefreshDatabases_Click"/></Grid>
                            <TextBlock x:Name="DatabaseStatusText" Text="Start MySQL in XAMPP, then refresh the database list." Foreground="{DynamicResource TextMuted}" FontSize="9" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardSurface}" CornerRadius="10" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="13" Margin="0,0,0,12">
                    <StackPanel><TextBlock Text="SCHEDULE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,9"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Frequency" FontSize="11" Margin="0,0,0,4"/><ComboBox x:Name="FrequencyBox" SelectionChanged="FrequencyBox_SelectionChanged"><ComboBoxItem Content="Hourly"/><ComboBoxItem Content="Daily"/><ComboBoxItem Content="Weekly"/><ComboBoxItem Content="Monthly"/></ComboBox></StackPanel>
                            <StackPanel x:Name="HoursPanel" Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Every hours" FontSize="11" Margin="0,0,0,4"/><TextBox x:Name="HoursBox"/></StackPanel>
                            <StackPanel x:Name="TimePanel" Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Start time" FontSize="11" Margin="0,0,0,4"/><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ComboBox x:Name="TimeHourBox" Width="50" Padding="3,7"/><TextBlock Text=":" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="3,0"/><ComboBox x:Name="TimeMinuteBox" Width="56" Padding="3,7"/><ComboBox x:Name="TimePeriodBox" Width="68" Padding="3,7" Margin="4,0,0,0"/></StackPanel></StackPanel>
                            <StackPanel x:Name="DayPanel" Grid.Column="2" Margin="10,0,0,0"><TextBlock Text="Day of week" FontSize="11" Margin="0,0,0,4"/><ComboBox x:Name="DayBox"><ComboBoxItem Content="Monday"/><ComboBoxItem Content="Tuesday"/><ComboBoxItem Content="Wednesday"/><ComboBoxItem Content="Thursday"/><ComboBoxItem Content="Friday"/><ComboBoxItem Content="Saturday"/><ComboBoxItem Content="Sunday"/></ComboBox></StackPanel>
                            <StackPanel x:Name="MonthDayPanel" Grid.Column="2" Margin="10,0,0,0"><TextBlock Text="Day of month" FontSize="11" Margin="0,0,0,4"/><ComboBox x:Name="MonthDayBox" ToolTip="If a month is shorter, the backup runs on its last day."/></StackPanel>
                        </Grid>
                        <TextBlock x:Name="MonthShortDayNote" Text="If that day doesn't exist, the backup runs on that month's final day." Foreground="{DynamicResource TextMuted}" FontSize="9" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="Collapsed"/>
                        <CheckBox x:Name="EnabledBox" Content="Enable automatic backup schedule" Margin="0,9,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardSurface}" CornerRadius="10" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="13">
                    <StackPanel><TextBlock Text="ZIP &amp; RETENTION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,9"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Compression" FontSize="11" Margin="0,0,0,4"/><ComboBox x:Name="CompressionBox"><ComboBoxItem Content="Optimal"/><ComboBoxItem Content="Fastest"/><ComboBoxItem Content="No compression"/></ComboBox></StackPanel><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="Keep newest ZIP files" FontSize="11" Margin="0,0,0,4"/><TextBox x:Name="RetentionBox"/><TextBlock Text="Enter 0 to keep all ZIP files." Foreground="{DynamicResource TextMuted}" FontSize="9" Margin="0,4,0,0"/></StackPanel></Grid>
                        <TextBlock Text="Older ZIP backups are removed once the configured limit is reached." FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,0"/>
                        <CheckBox x:Name="HiddenBox" Content="Include hidden files and folders" Margin="0,8,0,0"/>
                        <TextBlock Text="Exclude names or patterns (comma separated, e.g. *.tmp, node_modules, .git)" FontSize="10" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,5,0,4"/><TextBox x:Name="ExcludeBox"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0"><Button Content="Cancel" Margin="0,0,8,0" IsCancel="True"/><Button Content="Save profile" Background="{DynamicResource AccentGradient}" Foreground="White" BorderBrush="Transparent" IsDefault="True" Click="Save_Click"/></StackPanel>
    </Grid>
</Window>
